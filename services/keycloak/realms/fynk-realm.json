{
  "realm": "fynk",
  "displayName": "Fynk (local placeholder by M0, M1 replaces it)",
  "enabled": true,
  "loginWithEmailAllowed": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "defaultSignatureAlgorithm": "PS256",
  "accessTokenLifespan": 300,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@fynk.local",
    "fromDisplayName": "Fynk (local)"
  },
  "clients": [
    {
      "clientId": "fynk-mobile",
      "name": "Fynk app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["fynk://oauth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "fynk-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "fynk-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "fynk-api",
      "name": "Fynk API (token audience)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "demo@fynk.local",
      "email": "demo@fynk.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Demo",
      "lastName": "Fynk",
      "credentials": [
        {
          "type": "password",
          "value": "${FYNK_DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
