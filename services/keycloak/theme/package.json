{
  "name": "fynk-keycloak-theme",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.28.8",
  "description": "Keycloakify theme for the fynk realm (M1)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen": "keycloakify update-kc-gen",
    "build": "pnpm run gen && tsc && vite build",
    "build-keycloak-theme": "pnpm run build && keycloakify build",
    "typecheck": "pnpm run gen && tsc --noEmit",
    "format": "prettier --write .",
    "format-check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "keycloakify": "11.16.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
