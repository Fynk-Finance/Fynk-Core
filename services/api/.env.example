# Fynk API settings for a local run (go run ./cmd/api). Fake values only.
APP_ENV=local
PORT=8080
DATABASE_URL=postgres://fynk:fynk-local-only@localhost:5432/fynk?sslmode=disable
REDIS_URL=redis://localhost:6379/0
KEYCLOAK_ISSUER=http://localhost:8081/realms/fynk
KEYCLOAK_AUDIENCE=fynk-api
KEYCLOAK_URL=http://localhost:8081
# Caddy egress (M14) from the host, with the local CA that make certs creates.
EGRESS_URL=https://localhost:8443
EGRESS_CA_FILE=../../certs/ca.crt

# Secret of the Keycloak client fynk-admin (admin API). Same fake value as the root .env.example.
FYNK_ADMIN_CLIENT_SECRET=fynk-admin-local-only

# Bank link (M5). Optional: without them POST /bank/authorizations and the queries fail closed.
# Local keys only; in AWS they are KMS keys (M14). make certs creates both in certs/, and
# docker-compose.yml already passes these settings to the api container. To run the API outside
# Docker, uncomment them (the Banco Demo portal is plain HTTP on localhost:8082).
# BANK_SIGNER_KEY_FILE=../../certs/bank-signer.pem
# BANK_FINGERPRINT_KEY_FILE=../../certs/bank-fingerprint.key
# BANK_REDIRECT_URI=fynk://bank/callback
# BANCO_DEMO_CLIENT_ID=fynk
# BANCO_DEMO_ISSUER=http://localhost:8082
# BANCO_DEMO_AUTHORIZE_URL=http://localhost:8082/oauth/authorize
