# Mobile settings. EXPO_PUBLIC_* values are bundled into the app, so never put secrets here.
# Base URL of the Fynk API, without a trailing slash:
#   http://localhost:4010     Prism mock of the contract (make mock-api), the default
#   http://localhost:8080/v1  real local API
# On an Android emulator use 10.0.2.2 instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:4010

# Keycloak realm the app signs in with (M1). It must be the same issuer the API checks
# (KEYCLOAK_ISSUER), so on an Android emulator keep localhost and run
# `adb reverse tcp:8081 tcp:8081` instead of using 10.0.2.2.
EXPO_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8081/realms/fynk

# Development builds only: set to dev-token to skip the Keycloak sign-in and send the local
# API's dev-token (accepted only with APP_ENV=local). Ignored in release builds.
EXPO_PUBLIC_DEV_AUTH=
