# Mobile settings. EXPO_PUBLIC_* values are bundled into the app, so never put secrets here.
# Base URL of the Fynk API, without a trailing slash:
#   http://localhost:4010     Prism mock of the contract (make mock-api), the default
#   http://localhost:8080/v1  real local API
# On an Android emulator use 10.0.2.2 instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:4010
