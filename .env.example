# Local development values for docker compose (see docs/local-dev.md). Fake values only.
# make dev copies this file to .env when .env is missing. Never commit .env.
APP_ENV=local

POSTGRES_USER=fynk
POSTGRES_PASSWORD=fynk-local-only
POSTGRES_DB=fynk

# For tools on your machine (go run, go test -tags integration). The containers use their own URLs.
DATABASE_URL=postgres://fynk:fynk-local-only@localhost:5432/fynk?sslmode=disable
REDIS_URL=redis://localhost:6379/0

KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=fynk
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local-only
KEYCLOAK_DB_PASSWORD=keycloak-local-only

# Passwords of the seeded users of the local realms (services/keycloak/realms/).
FYNK_DEMO_USER_PASSWORD=Demo-local-1
BANCO_DEMO_USER_PASSWORD=Banco-local-1

# Secret of the fynk-admin Keycloak client (M1). The API uses it to read profiles and send
# verification emails. Staging takes it from Secrets Manager.
FYNK_ADMIN_CLIENT_SECRET=fynk-admin-local-only
