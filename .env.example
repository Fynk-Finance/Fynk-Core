# Local development values for docker compose (M0 Step 5). Fake values only.
# Copy to .env and never commit .env.
APP_ENV=local

POSTGRES_USER=fynk
POSTGRES_PASSWORD=fynk-local-only
POSTGRES_DB=fynk

DATABASE_URL=postgres://fynk:fynk-local-only@localhost:5432/fynk?sslmode=disable
REDIS_URL=redis://localhost:6379/0

KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=fynk
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local-only
